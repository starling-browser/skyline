<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Skyline.Gpu</RootNamespace>
    <!-- WebGPU interop is pointer-based end to end. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>WebGPU device, surface, and present mechanics for Skyline windows. Mirrors WebGPU rather than abstracting it — raw handles stay reachable.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- Lets benchmarks and tests build a WindowSurfaceCapabilities without a window. -->
    <InternalsVisibleTo Include="Skyline.Gpu.Benchmarks" />
    <InternalsVisibleTo Include="Skyline.Gpu.Tests" />
    <InternalsVisibleTo Include="Skyline.WindowedTests" />
  </ItemGroup>
  <!-- No reference to src/Skyline: the seam is Silk.NET's INativeWindowSource,
       which AppWindow.Surface exposes. Any window source works. -->
  <ItemGroup>
    <!-- The WebGPU API bindings only. Apps reference Silk.NET.WebGPU.Native.WGPU
         themselves to ship the wgpu_native binary, so this library never pins
         which native build a consumer deploys. -->
    <PackageReference Include="Silk.NET.WebGPU" />
    <PackageReference Include="Silk.NET.WebGPU.Extensions.WGPU" />
  </ItemGroup>
</Project>
