<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <RootNamespace>HelloClear</RootNamespace>
    <ApplicationId>dev.starling.helloclear</ApplicationId>
    <ApplicationTitle>HelloClear</ApplicationTitle>
    <!-- wgpu surface interop is pointer-based. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- NativeAOT: closure-delegate callbacks work, and there is no Mono
         interpreter dependency. Only `dotnet publish` engages it. -->
    <PublishAot>true</PublishAot>
    <!-- Simulator by default; pass -r ios-arm64 for a device build. -->
    <RuntimeIdentifier>iossimulator-arm64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Skyline.Gpu\Skyline.Gpu.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Silk.NET ships no iOS wgpu binary; ../wgpu-ios/build-wgpu.sh builds the
         wgpu-native commit Silk.NET 2.23's bindings were generated from. -->
    <NativeReference Include="..\wgpu-ios\native\$(RuntimeIdentifier)\libwgpu_native.a">
      <Kind>Static</Kind>
      <ForceLoad>True</ForceLoad>
      <Frameworks>Metal QuartzCore CoreFoundation</Frameworks>
    </NativeReference>
  </ItemGroup>
  <!-- Generated by build-wgpu.sh. The app resolves wgpu symbols from its own
       executable with dlsym, and the iOS link only exports listed symbols. -->
  <Import Project="..\wgpu-ios\WgpuSymbols.items" Condition="Exists('..\wgpu-ios\WgpuSymbols.items')" />
</Project>
