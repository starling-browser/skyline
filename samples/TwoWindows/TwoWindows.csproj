<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>TwoWindows</RootNamespace>
    <!-- Render passes are encoded with raw wgpu, which is pointer-based. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Skyline\Skyline.csproj" />
    <ProjectReference Include="..\..\src\Skyline.Gpu\Skyline.Gpu.csproj" />
    <ProjectReference Include="..\..\src\Skyline.Render\Skyline.Render.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.WebGPU.Native.WGPU" />
  </ItemGroup>
</Project>
