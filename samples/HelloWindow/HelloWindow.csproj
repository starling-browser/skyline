<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>HelloWindow</RootNamespace>
    <!-- wgpu surface/swapchain interop is pointer-based. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Skyline\Skyline.csproj" />
    <ProjectReference Include="..\..\src\Skyline.Gpu\Skyline.Gpu.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Apps pick the native WebGPU build they ship; this package puts the
         wgpu_native binary into runtimes/. Silk.NET.WebGPU itself comes
         through Skyline.Gpu. -->
    <PackageReference Include="Silk.NET.WebGPU.Native.WGPU" />
  </ItemGroup>
</Project>
